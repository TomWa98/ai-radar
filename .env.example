# AI Radar: lokale Konfiguration
#
# Einrichtung:  cp .env.example .env
# Die .env wird nicht eingecheckt. Trage echte Schlüssel nur dort ein.
# Bereits gesetzte Umgebungsvariablen haben Vorrang vor dieser Datei.

# --- Allgemein ---------------------------------------------------------------

# SQLite-Datei, relativ zum Arbeitsverzeichnis des Backends
AI_RADAR_DB=ai-radar.db

# Abrufintervall in Minuten; 0 schaltet den automatischen Abruf ab
AI_RADAR_FETCH_INTERVAL_MINUTES=15

# --- Analyse -----------------------------------------------------------------

# fake (kostenlos) oder openai (kostenpflichtige API-Aufrufe)
AI_RADAR_ANALYZER=fake

AI_RADAR_ANALYSIS_CONCURRENCY=2
AI_RADAR_ANALYSIS_MAX_ATTEMPTS=3

# --- OpenAI (nur bei AI_RADAR_ANALYZER=openai) ------------------------------

OPENAI_API_KEY=
AI_RADAR_OPENAI_MODEL=gpt-4.1-mini

# Konfigurierbare Schätzwerte in USD pro 1 Mio. Token, nur für Kostenerfassung
# und Budget. Sie werden nicht automatisch aktualisiert; bitte mit der aktuellen
# Preisliste von OpenAI abgleichen.
AI_RADAR_OPENAI_INPUT_PRICE_PER_MTOK=0.40
AI_RADAR_OPENAI_OUTPUT_PRICE_PER_MTOK=1.60

# Monatsbudget in USD. Bei 0 startet der OpenAI-Analyzer bewusst nicht;
# für echte Aufrufe einen Wert größer als 0 setzen.
AI_RADAR_MONTHLY_BUDGET=0
